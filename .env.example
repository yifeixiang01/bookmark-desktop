# ═══════════════════════════════════════════════════════════════
# 书签桌面 · 环境变量配置
#
# 使用方法：
#   1. 复制本文件为 .env        →  cp .env.example .env
#   2. 填写下方【必填】两项，其余可保持默认
#   3. 初始化数据库表结构        →  npm run db:push
#   4. 构建并启动               →  npm run build && npm start
#
# Docker 部署：先完成第 1、2 步（.env 会被打进镜像），
# 再执行  docker build -t bookmark-desktop . && docker run -p 3000:3000 bookmark-desktop
# 注意：容器启动后仍需执行一次 db:push（可在宿主机连库执行）初始化表结构。
# ═══════════════════════════════════════════════════════════════

# ── 【必填】MySQL 8 连接串 ─────────────────────────────────────
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 请自建 MySQL 8（或兼容的 TiDB / MariaDB 10.5+），并先创建空数据库：
#   CREATE DATABASE bookmark CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/bookmark

# ── 【必填】应用密钥（用于签发登录会话 JWT）────────────────────
# 请生成一段足够长的随机字符串，例如：
#   openssl rand -hex 32
# 生产环境缺失时服务将拒绝启动；泄露会导致登录态可被伪造，请勿提交到公开仓库。
APP_SECRET=

# ── 【可选】应用 ID ───────────────────────────────────────────
# 仅作为会话签名的 clientId 占位，填写任意字符串即可。
APP_ID=bookmark-desktop

# ── 【可选】管理员账号 ─────────────────────────────────────────
# 邮箱注册用户的 unionId 规则为  email:你的邮箱 ，例如：
#   OWNER_UNION_ID=email:admin@example.com
# 匹配的账号在下次登录时自动获得 admin 角色；留空则无人拥有管理员角色。
OWNER_UNION_ID=

# ── 以下为已废弃的 Kimi 登录配置，无需填写，可整段删除 ────────
# KIMI_AUTH_URL=
# KIMI_OPEN_URL=
# VITE_APP_ID=
# VITE_KIMI_AUTH_URL=
