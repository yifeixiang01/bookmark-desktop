{
  "name": "stashy-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config extension/vite.config.ts",
    "check": "tsc -p extension/tsconfig.json",
    "build": "node scripts/extension-icons.mjs && vite build --config extension/vite.config.ts",
    "package": "npm run build && powershell -NoProfile -File scripts/package-extension.ps1",
    "lint": "eslint extension/src extension/vite.config.ts",
    "extension:check": "npm run check",
    "extension:build": "npm run build",
    "extension:package": "npm run package"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
